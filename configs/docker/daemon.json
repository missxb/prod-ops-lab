{
    "// 注释": "Docker守护进程配置文件 - 生产环境标准配置",
    "// 说明": "配置镜像加速器、日志驱动、存储驱动、安全配置等",
    
    // ============================================
    // 镜像加速器配置
    // ============================================
    // 用于加速Docker镜像拉取，特别是在中国大陆地区
    "registry-mirrors": [
        "https://mirror.ccs.tencentyun.com",
        "https://docker.m.daocloud.io",
        "https://dockerhub.azk8s.cn",
        "https://hub-mirror.c.163.com"
    ],
    
    // ============================================
    // 存储驱动配置
    // ============================================
    // 使用overlay2存储驱动，这是目前推荐的生产级存储驱动
    "storage-driver": "overlay2",
    
    // 存储驱动的额外参数
    "storage-opts": [
        "overlay2.override_kernel_check=true",
        "overlay2.size=20G"
    ],
    
    // Docker数据目录，建议放在独立的磁盘分区
    "data-root": "/var/lib/docker",
    
    // ============================================
    // 日志驱动配置
    // ============================================
    // 使用json-file日志驱动，支持日志轮转
    "log-driver": "json-file",
    
    // 日志驱动的额外参数
    "log-opts": {
        "max-size": "100m",           // 单个日志文件最大100MB
        "max-file": "10",             // 最多保留10个日志文件
        "compress": "true",           // 启用日志压缩
        "labels": "service,environment",
        "tag": "{{.ImageName}}/{{.Name}}/{{.ID}}"
    },
    
    // ============================================
    // 网络配置
    // ============================================
    // 设置DNS服务器
    "dns": [
        "223.5.5.5",                  // 阿里云公共DNS
        "223.6.6.6",
        "8.8.8.8",
        "8.8.4.4"
    ],
    
    // DNS搜索域
    "dns-search": [
        "cluster.local",
        "svc.cluster.local",
        "cluster.local"
    ],
    
    // DNS选项
    "dns-opts": [
        "ndots:5",
        "timeout:2",
        "attempts:3"
    ],
    
    // MTU设置（根据网络环境调整）
    "mtu": 1500,
    
    // 网络后端配置
    "bip": "172.17.0.1/16",
    
    // 允许容器之间通过Docker网桥通信
    "com.docker.network.bridge.enable_icc": "true",
    
    // 禁用容器间iptables规则（生产环境推荐）
    "com.docker.network.bridge.enable_ip_masquerade": "true",
    
    // ============================================
    // 运行时配置
    // ============================================
    // 默认运行时
    "default-runtime": "runc",
    
    // 额外的运行时配置（支持Kata Containers等安全容器）
    "runtimes": {
        "runc": {
            "path": "runc"
        },
        "nvidia": {
            "path": "nvidia-container-runtime",
            "runtimeArgs": []
        }
    },
    
    // 容器默认的cgroup父级
    "cgroup-parent": "docker.slice",
    
    // 启用用户命名空间（安全增强）
    "userns-remap": "",
    
    // ============================================
    // 安全配置
    // ============================================
    // 禁用容器间通信（多租户环境推荐）
    // "icc": false,
    
    // 启用用户命名空间隔离
    "userns-remap": "",
    
    // 默认的ulimit配置
    "default-ulimits": {
        "nofile": {
            "Name": "nofile",
            "Hard": 65535,
            "Soft": 65535
        },
        "nproc": {
            "Name": "nproc",
            "Hard": 65535,
            "Soft": 65535
        },
        "memlock": {
            "Name": "memlock",
            "Hard": -1,
            "Soft": -1
        }
    },
    
    // ============================================
    // 资源限制配置
    // ============================================
    // 容器级默认资源限制
    "default-pids-limit": 4096,
    
    // 内存限制（字节，-1表示不限制）
    "default-memory": 0,
    
    // ============================================
    // 实验性功能
    // ============================================
    "features": {
        "buildkit": true              // 启用BuildKit构建器
    },
    
    // ============================================
    // 监控和调试配置
    // ============================================
    // 启用Docker metrics端点
    "metrics-addr": "0.0.0.0:9323",
    
    // 调试模式（生产环境应设为false）
    "debug": false,
    
    // ============================================
    // 日志级别
    // ============================================
    "log-level": "warn",
    
    // ============================================
    // 远程API配置（谨慎使用）
    // ============================================
    // "hosts": [
    //     "unix:///var/run/docker.sock",
    //     "tcp://0.0.0.0:2376"
    // ],
    
    // ============================================
    // 镜像清理配置
    // ============================================
    // 启用不使用镜像的自动清理
    "prune-images": true,
    
    // 保留最近使用的镜像数量
    "max-concurrent-downloads": 10,
    "max-concurrent-uploads": 5,
    
    // ============================================
    // 其他配置
    // ============================================
    // 实时存储（不缓存数据）
    "raw-logs": false,
    
    // 容器启动时的默认命令
    "default-shm-size": "64M",
    
    // 运行时执行器
    "exec-opts": [
        "native.cgroupdriver=systemd"
    ],
    
    // 启用容器健康检查
    "live-restore": true
}
