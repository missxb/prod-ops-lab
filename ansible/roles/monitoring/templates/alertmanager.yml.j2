# ansible/roles/monitoring/templates/alertmanager.yml.j2
# Alertmanager 配置文件 - 由 Ansible 自动管理

global:
  resolve_timeout: 5m
  smtp_smarthost: '{{ gitlab_smtp_server | default("smtp.company.com") }}:{{ gitlab_smtp_port | default(587) }}'
  smtp_from: 'alertmanager@{{ gitlab_smtp_domain | default("company.com") }}'
  smtp_auth_username: '{{ gitlab_smtp_user | default("alertmanager@company.com") }}'
  smtp_auth_password: '{{ gitlab_smtp_password | default("smtp_password") }}'
  smtp_require_tls: {{ gitlab_smtp_enable_starttls_auto | default(true) | lower }}

# 模板
templates:
  - '/etc/alertmanager/templates/*.tmpl'

# 接收者配置
receivers:
  - name: 'default'
    email_configs:
      - to: 'ops-team@{{ gitlab_smtp_domain | default("company.com") }}'
        send_resolved: true
    webhook_configs:
      - url: 'http://localhost:9095/alert/webhook'
        send_resolved: true

  - name: 'critical'
    pagerduty_configs:
      - routing_key: '{{ pagerduty_routing_key | default("") }}'
    email_configs:
      - to: 'ops-team@{{ gitlab_smtp_domain | default("company.com") }}'
        send_resolved: true
    webhook_configs:
      - url: 'http://localhost:9095/alert/webhook'
        send_resolved: true

  - name: 'slack'
    slack_configs:
      - api_url: '{{ slack_webhook_url | default("") }}'
        channel: '#alerts'
        send_resolved: true
        title: '{{ '{{' }} .GroupLabels.alertname {{ '}}' }}'
        text: '{{ '{{' }} range .Alerts {{ '}}' }}{{ '{{' }} .Annotations.description {{ '}}' }}{{ '{{' }} end {{ '}}' }}'

# 路由配置
route:
  receiver: 'default'
  group_by: ['alertname', 'cluster', 'service']
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 24h
  routes:
    - match:
        severity: 'critical'
      receiver: 'critical'
      group_wait: 10s
      group_interval: 5m
      repeat_interval: 4h

    - match:
        severity: 'warning'
      receiver: 'default'
      group_wait: 30s
      group_interval: 5m
      repeat_interval: 12h

# 抑制规则
inhibit_rules:
  - source_match:
      severity: 'critical'
    target_match:
      severity: 'warning'
    equal: ['alertname', 'cluster', 'service']
